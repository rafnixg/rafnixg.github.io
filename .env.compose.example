# Solo desarrollo local. Copia este archivo como .env.compose.local y reemplaza cada valor.
CMS_POSTGRES_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD
CMS_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
CMS_SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CMS_ARTICLE_SYNC_TOKEN=CHANGE_ME_WITH_A_DIFFERENT_32_CHAR_RANDOM_TOKEN
# Cambia estos puertos si otro proceso local ya utiliza los valores por defecto.
CMS_WEB_PORT=8000
CMS_API_PORT=8001
CMS_POSTGRES_PORT=5433
