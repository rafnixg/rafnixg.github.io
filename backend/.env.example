# Prefer separate fields so special characters in the password are encoded safely.
DATABASE_SCHEME=postgresql+psycopg
DATABASE_USER=cms
DATABASE_PASSWORD=CHANGE_ME
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=cms
# Alternatively, set DATABASE_URL explicitly (it must be a valid URL).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ARTICLE_SYNC_TOKEN=REPLACE_WITH_A_DIFFERENT_32_CHAR_RANDOM_TOKEN
COOKIE_SECURE=true
MEDIA_DIR=/app/uploads
CORS_ORIGINS=https://rafnixg.dev,https://www.rafnixg.dev,https://rafnixg.github.io,https://resume.rafnixg.dev
# Local development: set COOKIE_SECURE=false and add http://localhost:8000 to CORS_ORIGINS.
